diff --git a/crypto/lz4kd/crypto.c b/crypto/lz4kd/crypto.c
new file mode 100644
index 0000000000000000000000000000000000000000..e5e7edb5d8f1ade759e49f745403f71e3f5b7245
--- /dev/null
+++ b/crypto/lz4kd/crypto.c
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2022. All rights reserved.
+ * Description: LZ4KD compression algorithm for ZRAM
+ */
+
+#include <crypto/algapi.h>
+#include <linux/crypto.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+
+#include "lz4kd.h"
+
+struct lz4kd_ctx {
+	void *workspace;
+};
+
+static int lz4kd_init(struct crypto_tfm *tfm)
+{
+	struct lz4kd_ctx *ctx = crypto_tfm_ctx(tfm);
+
+	ctx->workspace = vmalloc(lz4kd_encode_state_bytes_min());
+	if (!ctx->workspace)
+		return -ENOMEM;
+
+	return 0;
+}
+
+static void lz4kd_exit(struct crypto_tfm *tfm)
+{
+	struct lz4kd_ctx *ctx = crypto_tfm_ctx(tfm);
+
+	vfree(ctx->workspace);
+}
+
+static int lz4kd_compress_page(struct crypto_tfm *tfm, const u8 *src,
+			      unsigned int slen, u8 *dst, unsigned int *dlen)
+{
+	struct lz4kd_ctx *ctx = crypto_tfm_ctx(tfm);
+	int size;
+
+	if (slen != PAGE_SIZE || *dlen < 2 * PAGE_SIZE)
+		return -EINVAL;
+
+	size = lz4kd_encode(ctx->workspace, src, dst, slen, *dlen, 0);
+	if (size < 0)
+		return -EINVAL;
+
+	/* A full-sized result is stored as a raw page by ZRAM. */
+	if (size == LZ4K_STATUS_INCOMPRESSIBLE || size >= PAGE_SIZE) {
+		memcpy(dst, src, PAGE_SIZE);
+		size = PAGE_SIZE;
+	}
+
+	*dlen = size;
+	return 0;
+}
+
+static int lz4kd_decompress_page(struct crypto_tfm *tfm, const u8 *src,
+				unsigned int slen, u8 *dst, unsigned int *dlen)
+{
+	if (!slen || slen > PAGE_SIZE || *dlen < PAGE_SIZE)
+		return -EINVAL;
+
+	if (slen == PAGE_SIZE)
+		memcpy(dst, src, PAGE_SIZE);
+	else if (lz4kd_decode(src, dst, slen, PAGE_SIZE) != PAGE_SIZE)
+		return -EINVAL;
+
+	*dlen = PAGE_SIZE;
+	return 0;
+}
+
+static struct crypto_alg lz4kd_alg = {
+	.cra_name = "lz4kd",
+	.cra_driver_name = "lz4kd-generic",
+	.cra_flags = CRYPTO_ALG_TYPE_COMPRESS,
+	.cra_ctxsize = sizeof(struct lz4kd_ctx),
+	.cra_module = THIS_MODULE,
+	.cra_init = lz4kd_init,
+	.cra_exit = lz4kd_exit,
+	.cra_u.compress = {
+		.coa_compress = lz4kd_compress_page,
+		.coa_decompress = lz4kd_decompress_page,
+	},
+};
+
+static int __init lz4kd_module_init(void)
+{
+	return crypto_register_alg(&lz4kd_alg);
+}
+
+static void __exit lz4kd_module_exit(void)
+{
+	crypto_unregister_alg(&lz4kd_alg);
+}
+
+subsys_initcall(lz4kd_module_init);
+module_exit(lz4kd_module_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("LZ4KD page compression");
+MODULE_ALIAS_CRYPTO("lz4kd");
