+inline static void copy_2x(
+	uint8_t *dst,
+	const uint8_t *src,
+	const size_t copy_min)
+{
+	m_copy(dst, src, copy_min);
+	m_copy(dst + copy_min, src + copy_min, copy_min);
+}
